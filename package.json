{
  "name": "antigravity-chat-sync",
  "version": "2.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Project-scoped multi-agent AI conversation archiver, sync engine, and cross-agent session handoff bridge for Antigravity, Claude Code, Codex, and Cursor.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MahmoudELsawy0357/antigravity-chat-sync.git"
  },
  "bin": {
    "antigravity-chat-sync": "./src/cli.ts"
  },
  "scripts": {
    "setup": "bun run src/bootstrap.ts",
    "init": "bun run src/init.ts",
    "sync": "bun run src/sync.ts",
    "restore": "bun run src/restore.ts",
    "handoff": "bun run src/handoff.ts",
    "continue": "bun run src/handoff.ts",
    "search": "bun run src/search.ts",
    "launch": "bun run src/launch.ts",
    "daemon": "bun run src/daemon.ts",
    "autostart": "bun run src/autostart.ts",
    "autostart:stop": "bun run src/autostart.ts --remove",
    "shortcut": "bun run src/shortcut.ts",
    "plugin:install": "bun run src/plugin-install.ts",
    "plugin:uninstall": "bun run src/plugin-install.ts --uninstall",
    "status": "bun run src/status.ts",
    "doctor": "bun run src/status.ts",
    "verify": "bun run src/verify.ts",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
