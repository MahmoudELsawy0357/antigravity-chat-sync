{
  "name": "antigravity-chat-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Project-scoped Google Antigravity conversation archiver and multi-device sync toolkit backed by a private GitHub repository.",
  "scripts": {
    "init": "bun run src/init.ts",
    "sync": "bun run src/sync.ts",
    "restore": "bun run src/restore.ts",
    "launch": "bun run src/launch.ts",
    "daemon": "bun run src/daemon.ts",
    "autostart": "bun run src/autostart.ts",
    "autostart:stop": "bun run src/autostart.ts --remove",
    "shortcut": "bun run src/shortcut.ts",
    "status": "bun run src/status.ts",
    "doctor": "bun run src/status.ts",
    "verify": "bun run src/verify.ts",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
